# PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# PayPal webhook (your app → Webhooks). Required in production; locally the scripts can skip it.
PAYPAL_WEBHOOK_ID=
# PAYPAL_WEBHOOK_SKIP_VERIFY=true

# Claude (platform.claude.com → API keys)
ANTHROPIC_API_KEY=
# The agent and the split. Opus by default; Sonnet is cheaper for development.
# AGENT_MODEL=claude-sonnet-5-5
# Reading booking confirmations
# EXTRACTION_MODEL=claude-haiku-5-5

# Local Postgres (docker compose up -d)
DATABASE_URL=postgres://trippot:trippot@localhost:5433/trippot

# Where scripts/simulate-payments.mts posts its webhooks
# APP_URL=http://localhost:3100

