# PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Voiceover for the demo video (optional)
ELEVENLABS_API_KEY=

# Local Postgres (docker compose up -d)
DATABASE_URL=postgres://trippot:trippot@localhost:5433/trippot

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional model overrides
# AGENT_MODEL=claude-sonnet-5-5
# EXTRACTION_MODEL=claude-haiku-5-5

# PayPal webhook (dashboard → app → Webhooks), needed in production
PAYPAL_WEBHOOK_ID=
# PAYPAL_WEBHOOK_SKIP_VERIFY=true  # local scripts only
