{
  "name": "trippot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port ${PORT:-3100}",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "validate:paypal": "node --env-file=.env scripts/validate-sandbox.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "smoke:pot": "tsx --env-file=.env --conditions=react-server scripts/smoke-pot.mts",
    "try:extract": "tsx --env-file=.env --conditions=react-server scripts/try-extract.mts",
    "seed:demo": "tsx --env-file=.env --conditions=react-server scripts/seed-demo.mts",
    "simulate:payments": "tsx --env-file=.env --conditions=react-server scripts/simulate-payments.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.7",
    "@bryntum/scheduler-react": "7.3.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0"
}
